#/*****************************************************************************
#/ @(#) $Id: Makefile.in,v 1.30 2003/12/05 16:55:00 virzak Exp $ 
#/ 
#/  Description: 
#/      This file is responsible for building the executable for linux
#/
#/  =
#/
#/*****************************************************************************


CXX = @CXX@


CXXFLAGS=@CXXFLAGS@
LDFLAGS=-L/usr/X11R6/lib -lGL -lGLU -lXxf86vm -ljpeg -lpatch -lsubdiv -lgrutil @LDFLAGS@

ifeq (${CONF}, release) 
  ifeq (${CXX},icc)
    LDFLAGS+=-static-libcxa
  endif
else
  CXXFLAGS+=-g

  ifeq (${CXX},icc)
    CXXFLAGS+=-Wall -Werror -wd981,383 -unroll
  endif
  ifeq (${CXX},g++)
    CXXFLAGS+=-Wall -Werror -funroll-loops
  endif
  ifeq (${CXX},CC)
    CXXFLAGS+=-fullwarn -LANG:std
  endif
	  
endif

CXXFLAGS+=${CXXFLAGSEXTRA}

OBJS = gr.o world.o polygon.o wall.o object.o engine.o stain.o player.o ui.o \
        timer.o window.o output.o xray.o textures.o camera.o background.o \
        light.o objgroups.o mobject.o

all: fps

fps: ${OBJS}
	$(CXX) ${OBJS} -o $@ ${LDFLAGS} 
        
count:
	grep -E -v '^(.*@\(#\).*)*[[:space:]]*$$' *.cpp *.h | wc

status:
	cvs status | grep Locally

clean:
	-rm -f core *.o *~
        
distclean: clean
	-rm -rf fps


