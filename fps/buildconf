# Remove autoconf 2.5x's cache directory
rm -rf autom4te*.cache


config_h_in="config.h.in"

echo rebuilding $config_h_in
rm -f $config_h_in
${AUTOHEADER:-autoheader}

echo rebuilding configure
rm -f config.cache
${AUTOCONF:-autoconf}

exit 0

