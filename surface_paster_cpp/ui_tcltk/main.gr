set DIR_Y 2
set DIR_Z 3

set mainNode :


#ResetAll

set spec [list 0.0 0.0 0.0]




proc mullist {l m} {
  foreach elem $l {
    lappend res [expr round($elem*$m)]
  }
  return $res
}


proc reg_material {name diff spec phong} {

  global colors
    
  set colors($name) [mullist $diff 255.0]
  
  gr_exec gr_material $name $diff $spec $phong
  
}




