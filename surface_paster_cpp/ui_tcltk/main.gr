# Give application a title
wm title . "Surface Paster"

# Set desired bounds on overall dimensions
wm minsize . 200 200
wm maxsize . 1000 1000

# Desired initial width and height of the OpenGL widget
set width 640
set height 480

set out [open main.log w]

set start_clock [clock clicks -milliseconds]
proc gr_exec {args} {
  global out start_clock
  puts $out "[expr [clock clicks -milliseconds]-$start_clock] $args"
#puts $args
  eval $args
}


proc gr_redraw {} {
  global raster
  gr_exec $raster render
}


proc gr_terminate {} {
  gr_exec exit
}


# -----------------------------------------------------------------------
# The menu bar 
# -----------------------------------------------------------------------
set menuBar .mbar
frame .mbar -relief raised -bd 4
pack .mbar -side top -anchor w -fill x

# -----------------------------------------------------------------------
# File menu 
# -----------------------------------------------------------------------
menubutton .mbar.fileMenu -text File -menu .mbar.fileMenu.menu
menu .mbar.fileMenu.menu

# Reset Entries entry 
.mbar.fileMenu.menu add command -label "Reset Position" -accelerator I -command {ResetPosition; gr_redraw}
.mbar.fileMenu.menu add command -label "Reset Orientation" -accelerator O -command {ResetOrientation; gr_redraw}
.mbar.fileMenu.menu add command -label "Reset Joints" -accelerator N -command {ResetJoints}
.mbar.fileMenu.menu add command -label "Reset All" -accelerator R -command {ResetPosition; ResetPosition; ResetOrientation; gr_redraw}

# `Quit' entry 
.mbar.fileMenu.menu add command -label "Quit" -accelerator Q -command gr_terminate 


menubutton .mbar.patchMenu -text "Patch" -menu .mbar.patchMenu.menu
menu .mbar.patchMenu.menu

.mbar.patchMenu.menu add command -label "Add Patch" -accelerator "Ctrl+N" -command addPatch
.mbar.patchMenu.menu add separator 
.mbar.patchMenu.menu add command -label "Set border CPs to Greville" -accelerator "Ctrl+G" -command {gr_exec gr_cp_scheme {} 0 0; gr_redraw}
.mbar.patchMenu.menu add command -label "Set all CPs to Greville" -command {gr_exec gr_cp_scheme {} 0 1; gr_redraw}
.mbar.patchMenu.menu add command -label "Spread border CPs evenly" -accelerator "Ctrl+E" -command {gr_exec gr_cp_scheme {} 1 0; gr_redraw}
.mbar.patchMenu.menu add command -label "Spread all CPs evenly" -command {gr_exec gr_cp_scheme {} 1 1; gr_redraw}



menubutton .mbar.modeMenu -text "Mode" -menu .mbar.modeMenu.menu
menu .mbar.modeMenu.menu

.mbar.modeMenu.menu add radio -label "Position/Orientation" -accelerator P -command {} -variable mode -value orient
.mbar.modeMenu.menu add radio -label "Joints" -accelerator J -command {} -variable mode -value joints




menubutton .mbar.drawModeMenu -text "Draw Mode" -menu .mbar.drawModeMenu.menu
menu .mbar.drawModeMenu.menu

.mbar.drawModeMenu.menu add radio -label "Wire-Frame" -accelerator W -command {gr_exec gr_mode W; gr_redraw} -variable drawMode -value wire
.mbar.drawModeMenu.menu add radio -label "Shaded" -accelerator F -command {gr_exec gr_mode F; gr_redraw} -variable drawMode -value face
.mbar.drawModeMenu.menu add radio -label "Control Net" -accelerator N -command {gr_exec gr_mode C; gr_redraw} -variable drawMode -value net
.mbar.drawModeMenu.menu add separator

set i 0
foreach lab [list view_local_frame net_and_curves greville_range view_parent_sfc] values {0 0 0 0} {
  set d$i $values
  .mbar.drawModeMenu.menu add check -label $lab -variable d$i -command "gr_toggle $i; \gr_redraw"
  incr i
}



menubutton .mbar.otherMenu -text "Other" -menu .mbar.otherMenu.menu
menu .mbar.otherMenu.menu

.mbar.otherMenu.menu add checkbutton -label "Approximation" -accelerator A -command {gr_exec gr_approx; gr_redraw} -variable huy2





menubutton .mbar.optionsMenu -text "Options" -menu .mbar.optionsMenu.menu
menu .mbar.optionsMenu.menu

.mbar.optionsMenu.menu add check -label "Circle" -accelerator C -command {gr_exec gr_trackball "" {0 0} {0 0} 0; gr_redraw} -variable circle



pack .mbar.fileMenu .mbar.patchMenu .mbar.modeMenu .mbar.drawModeMenu .mbar.optionsMenu .mbar.otherMenu -side left

# -----------------------------------------------------------------------
# Make OpenGL display area using Togl
# -----------------------------------------------------------------------
frame .ui -bd 2m -relief sunken
frame .frame -bd 2m -relief sunken
pack .frame .ui -side left -expand yes -fill both -padx 2m -pady 2m

# Use a variable to keep track of this widget
set raster .frame.raster

# Set up the OpenGL rendering area with all the options we'll need
togl $raster \
    -rgba true \
    -redsize 2 \
    -greensize 2 \
    -bluesize 2 \
    -depth true \
    -depthsize 12 \
    -double true \
    -width $width \
    -height $height
pack $raster -padx 1m -pady 1m -fill both -expand yes 


if {0} {
frame .bottom
pack .bottom -fill both -expand yes

entry .bottom.entry -width 30 -textvariable prompt_cmd
pack .bottom.entry -side top 

bind .bottom.entry <Return> {puts $prompt_cmd}
bind Entry <KP_Enter> [bind .bottom.entry <Return>]
}

# -----------------------------------------------------------------------
# Event Bindings 
# -----------------------------------------------------------------------

# Mouse button 1 depressed
bind $raster <Button-1> {
    if {$comments} {
        puts stderr "Testing: <Button-1> event"
    }
    set b1 1
}


proc switchColor {huy} {
    global attributes physical raster
    
    if {[lindex $attributes($huy) 2] == 0} {
        set attributes($huy) [eval list [lrange $attributes($huy) 0 1] 1 \
            [lrange $attributes($huy) 3 end]]
        gr_exec gr_surfaceproperty $huy selected
    } else {
        set attributes($huy) [eval list [lrange $attributes($huy) 0 1] 0 \
            [lrange $attributes($huy) 3 end]]
        gr_exec gr_surfaceproperty $huy [lindex $attributes($huy) 0]
    }
}

# Mouse button 1 released
bind $raster <ButtonRelease-1> {
    if {$comments} {
        puts stderr "Testing: <ButtonRelease-1> event"
    }
    set b1 0
    if {$mode == "joints"} {
        set pick [gr_exec gr_pick : [list %x %y]]
        
#puts $pick

        if {$pick != ""} {
          #set pick_list [split $pick ":"]
          #set main_node [join [lrange $pick_list 0 [expr [llength $pick_list] - 4]] :]
          set main_node $pick
        
#switchColor $main_node
          if {[lindex $pick 1] != -1} {
            eval gr_exec gr_select_cp $pick
          }
        }
     
        gr_redraw
    }
}

# Mouse button 2 depressed
bind $raster <Button-2> {
    if {$comments} {
        puts stderr "Testing: <Button-2> event"
    }
    set b2 1
}

# Mouse button 2 released
bind $raster <ButtonRelease-2> {
    if {$comments} {
        puts stderr "Testing: <ButtonRelease-2> event"
    }
    set b2 0
}

# Mouse button 3 depressed
bind $raster <Button-3> {
    if {$comments} {
        puts stderr "Testing: <Button-3> event"
    }
    set b3     1
}

# Mouse button 3 released
bind $raster <ButtonRelease-3> {
    if {$comments} {
        puts stderr "Testing: <ButtonRelease-3> event"
    }
    set b3 0
}

proc rotationNode {name} {
    return :[join [lrange [split $name :] 1 end-1] : ]
}

# Mouse moved
bind $raster <Motion> {
    if {$comments} {
        puts stderr "Testing: <Motion> event: %x,%y"
    }

    set lastx $x
    set x %x
    set lasty $y
    set y %y

    set xm 0
    set ym 0
    set zm 0

    set changes [expr $b1 | $b2 | $b3]
    
    if {$mode == "orient"} {
        foreach a [list b1 b2 b3] {
            if {[set $a]} {
                set "${a}m" [expr (%x-$lastx)/40.0]
            } else {
                set "${a}m" 0
            }
        }
        
        if {$b1} {
            set xm [expr (%x-$lastx)/$translationFactor]
            set ym [expr -(%y-$lasty)/$translationFactor]
            gr_exec gr_translate $mainNode [list $xm $ym 0]
        }
        
        if {$b2} {
            set zm [expr -(%y-$lasty)/($translationFactor/2.0)]
            gr_exec gr_translate $mainNode [list 0 0 $zm]
        }
        
        if {$b3} {
            gr_exec gr_trackball :trackball [list $lastx [expr 0+$lasty]] \
                              [list %x [expr 0+%y]] 1
        }
        if {$changes} {
        }
    } else {

      if {$b2} {
        if {0} {  
            #comment this out

            foreach node [array names attributes] {
                if {[lindex $attributes($node) 2] == 1} {
                    gr_exec gr_rotate $node:rot x [expr (%y-$lasty)/20.0]
                }
            }
        }
        
        set xm [expr (%x-$lastx)/$translationFactor]
        set ym [expr -(%y-$lasty)/$translationFactor]
        gr_exec gr_mv_ctrl_pts $mainNode [list $xm $ym 0]        

        
      }
        
      if {$b3} {
        
            set zm [expr (%x-$lastx)/$translationFactor]
            gr_exec gr_mv_ctrl_pts $mainNode [list 0 0 $zm]        

        
      }
        
    }
    
    # post redisplay
    if {$changes} {gr_redraw}
}

