#!/bin/csh
#\
exec ./sp -f $0 $*

source combobox.tcl
catch {namespace import combobox::*}

# ========================================================================= #
#                                 CS 488/688                                #
#                          Introduction to Graphics                         #
#                                                                           #
#                  Assignment 3: Hierarchical Transformations               #
#                                                                           #
