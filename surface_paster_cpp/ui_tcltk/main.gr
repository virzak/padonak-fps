source dialog.tcl

set prompt(m) 7
set prompt(n) 6
set patch_color patch
set p_number 0


proc getColor {col} {
  global colors
  return [eval {format "#%02x%02x%02x"} $colors($col)]
}

proc gy {disp w col} {
#puts "calling gy with $disp $w $col"
  $disp config -background [getColor $col]
}


proc addPatch {} {
  global colors prompt patch_color p_number parent_patch
    
  
  set patch_color [lindex [array names colors] $p_number]  
  if {$p_number} {
    set parent_patch [expr $p_number]
  }

#puts "$patch_color [array names colors]"
#puts "$parent_patch [expr $p_number-1]"
  
  set f .prompt
  if [Dialog_Create $f "New Patch" -borderwidth 10] {
    message $f.msg -text "Add a new Patch" -aspect 1000

    frame $f.size -relief groove -borderwidth 3

    set s [frame $f.size.s]
    label $s.label -text "M: "
    entry $s.entry -width 2 -textvariable prompt(m)
    pack $s.label $s.entry -side left -pady 5  -padx 5  
    pack $s
    
    set t [frame $f.size.t]
    label $t.label -text "N: "
    entry $t.entry -width 2 -textvariable prompt(n)
    pack $t.label $t.entry -side left -pady 5  -padx 5  
    pack $t

    set b [frame $f.buttons]

    
#color
    frame $f.color -relief groove -borderwidth 3
    label $f.color.label -text "Color: "
    combobox $f.color.colCombo \
      -textvariable patch_color \
      -editable false \
      -highlightthickness 1 \
      -command [list gy $f.color.disp]
    
    frame $f.color.disp -relief sunken -borderwidth 2 -width 20 -height 20 -background white
    
    set widest 0
    foreach family [lsort [array names colors]] {
      if {$family != "selected"} {
	if {[set length [string length $family]] > $widest} {
	    set widest $length
	}
	$f.color.colCombo list insert end $family
      }
    }
    $f.color.colCombo configure -width $widest

    
    
    pack $f.color.label $f.color.colCombo $f.color.disp -side left -pady 5 -padx 5

    
#parent
    frame $f.parent -relief groove -borderwidth 3
    label $f.parent.label -text "Parent Patch: "
    combobox $f.parent.parCombo \
      -textvariable parent_patch \
      -editable false \
      -highlightthickness 1 
        
#puts "pnumber = $p_number"
#for {set i 1} {$i < $p_number} {incr i} {
#	$f.parent.parCombo list insert end $i
#   }
    $f.parent.parCombo configure -width 2

    
    
    pack $f.parent.label $f.parent.parCombo -side left -pady 5 -padx 5

    


#other
    
    pack $f.msg $f.size $f.color $f.parent $f.buttons -side top -fill x
    pack $f.size $f.color -pady 5

    
    button $b.ok -text OK -command {set prompt(ok) 1}
    button $b.cancel -text Cancel -command {set prompt(ok) 0}
    pack $b.ok -side left
    pack $b.cancel -side right
    bind Entry <Return> {set prompt(ok) 1 ; break}
    bind Entry <KP_Enter> [bind Entry <Return>]
    bind Entry <Control-c> {set prompt(ok) 0 ; break}
    bind Entry <Escape> [bind Entry <Control-c>]
  } else {
    .prompt.parent.parCombo list insert end [expr $p_number]
  }
  gy .prompt.color.disp .prompt.color.colCombo $patch_color

    
  set prompt(ok) 0
  Dialog_Wait $f prompt(ok) $f.size.s.entry
  Dialog_Dismiss $f
  if {$prompt(ok)} {
        buildPatch $prompt(m) $prompt(n) $patch_color $parent_patch
        if {$prompt(m) > 4} {
          incr prompt(m) -1
        }
        if {$prompt(n) > 4} {
          incr prompt(n) -1
        }
  } else {
  	return {}
  }
  
}






proc buildPatch {m n c parent} {
  global attributes
  global p_number
  global patches
  set list_of_points {}
  
  for {set i 0} {$i < $m} {incr i} {
    for {set j 0} {$j < $n} {incr j} {
      lappend list_of_points \
        [list [expr $i * ($m.0-3) / ($m.0-1)] 0 [expr $j*($n.0-3)/($n.0-1)]]
    }
  }
  
  set list_of_vertices {}
  
  for {set i 0} {$i < $m} {incr i} {
    set tmp {}
    for {set j 0} {$j < $n} {incr j} {
      lappend tmp [expr $i*$n+$j]
    }
    lappend list_of_vertices $tmp
  }
    
  incr p_number
  gr_exec gr_patch :trackball:tr patch$p_number $list_of_points \
        $list_of_vertices

#set prev_p_number [expr $p_number - 1]
  set parenttag {}
  set node :trackball:tr:patch$p_number
  if {$parent != "" && $parent != 0} {
#gr_exec gr_set_patch_parent :trackball:tr:patch$p_number :trackball:tr:patch$prev_p_number
    gr_exec gr_set_patch_parent $node :trackball:tr:patch$parent
#set parenttag p$prev_p_number
    set parenttag p$parent
  }
  

  set patches(p$p_number) [list $node $c]
  addSquare $p_number [getColor $c] $m $n $parenttag
  lappend attributes($node) $c 1 0
  gr_exec gr_surfaceproperty $node [lindex $attributes($node) 0]
  gr_redraw
}



set sq_length 10
set factor 60.0

proc addSquare {number col m n parenttag} {
  global ui patches sq_length factor

  set tag p$number
  
  set c $ui.c
  set p_coords [$c coords $parenttag]
  if {$p_coords != ""} {
    set top_x [lindex $p_coords 0]
    set top_y [lindex $p_coords 1]
  } else {
    set top_x [expr 50] 
    set top_y [expr 50]
  }
  set bot_x [expr $top_x+$factor*($m-3.0)] 
  set bot_y [expr $top_y+$factor*($n-3.0)]
  
  $c create poly $top_x $top_y $top_x $bot_y $bot_x $bot_y $bot_x $top_y -fill $col -tag [list $tag ${tag}_c] -outline black -width 1
#$c create rect $top_x $top_y $bot_x $bot_y -fill $col -tag [list $tag ${tag}_c]
  $c create rect [expr $bot_x-$sq_length] [expr $bot_y-$sq_length] \
    $bot_x $bot_y -fill black -tag [list $tag ${tag}_s]
  $c create text [expr $top_x+7] [expr $top_y+12] -text $number -tag $tag
  $c bind $tag <Button-1> [list PatchMark %W %x %y $tag]
  $c bind $tag <B1-Motion> [list PatchDrag %W %x %y $tag]
}

set PI 3.1415927

proc get_angle {dx dy} {
  global PI
    if {$dx != 0} {
      set angle [expr atan($dy/-$dx)]
      if {$dx < 0} {set angle [expr $angle + $PI]}
    } else {
      set angle [expr ($dy<0)?$PI/2:-$PI/2];
    }

    return $angle
}


# Rotation routine
proc PRotate {init w x y} {
  global angle prev_angle marked patches PI
  
  if {$marked == {}} {
    return 
  }
  
    if {!$init} {
      set prev_angle $angle
    }
    
    set last_r_x $x
    set last_r_y $y
    set dx [expr $x - [winfo width $w]/2.0]
    set dy [expr $y - [winfo height $w]/2.0]
   
#set angle_rad [get_angle $dx $dy]
#set angle [expr 180*$angle_rad/$PI]
    set angle [get_angle $dx $dy]

#puts $angle
#return 
      
    if {!$init} {
      set angle_difference [expr $angle - $prev_angle]
#puts "$angle_difference   [lindex $patches($marked) 0]"
      gr_exec gr_rotate [lindex $patches($marked) 0] y [expr 180.0*$angle_difference/$PI] 1
      gr_redraw


      set coords [$w coords $marked]
      foreach x {2 4 6} y {3 5 7} {
        set dx [expr [lindex $coords $x] - [lindex $coords 0]]
        set dy [expr [lindex $coords $y] - [lindex $coords 1]]
        set dist [expr sqrt($dx*$dx + $dy*$dy)]
        
        set a1 [get_angle $dx $dy]
        set new_a1 [expr $a1+$angle_difference]

        set new_coords [list [expr [lindex $coords 0] + $dist*cos($new_a1)] [expr [lindex $coords 1] - $dist*sin($new_a1)]]

        set coords [eval {lreplace $coords $x $y} $new_coords]
      }
      
      $w coords $marked $coords
    }
    
    return
  
}


proc buildUI {} {
  global ui
  set c [canvas $ui.c -width 400 -height 400 -background #088]
  bind $c <Button-2> {PRotate 1 %W %x %y}
  bind $c <B2-Motion> {PRotate 0 %W %x %y}
  pack $c 
  set tag movable1
}



proc ToggleDM {} {
  if {0} {
  global ui
    
  global toolbox
  if {$toolbox} {
    toplevel .dm
    wm transient .dm .
    wm title .dm "Domain Manager"
    set ui .dm
    buildUI
  } else {
    destroy .dm
  }
  }
}

set ui .ui
buildUI


set marked {}


proc PatchMark {w x y tag} {
  
  global dm marked patches sq_length
  
  if {[expr [lindex [$w coords $tag] 4]-$x] < $sq_length &&
      [expr [lindex [$w coords $tag] 5]-$y] < $sq_length
  } {
    set pscale 1
  } else {
    set pscale 0
  }
  
  set dm($w,$tag) [list $x $y $pscale]
  if {$marked != {}} {
    set c [getColor [lindex $patches($marked) 1]]
    $w itemconfig ${marked}_c -fill $c
  }
  $w itemconfig ${tag}_c -fill [getColor selected]
  set marked ${tag}
#puts "marked = $marked"
  
#puts [$w itemcget $tag -fill]
}


proc PatchDrag {w x y tag} {
  global dm patches raster factor
  set prev $dm($w,$tag)
  set dm($w,$tag) [list $x $y [lindex $prev 2]]
  set dx [expr $x - [lindex $prev 0]]
  set dy [expr $y - [lindex $prev 1]]

  if {[lindex $prev 2]} {

    set coords [$w coords $tag]
      
    set prev_size [list \
      [expr [lindex $coords 4] - [lindex $coords 0]] \
      [expr [lindex $coords 5] - [lindex $coords 1]] \
    ]
    
    set scx [expr ([lindex $prev_size 0] + $dx) / [lindex $prev_size 0]]
    set scy [expr ([lindex $prev_size 1] + $dy) / [lindex $prev_size 1]]
     

    set new_x [expr [lindex $coords 4] + $dx]
    set new_y [expr [lindex $coords 5] + $dy]
    
    set coords [lreplace $coords 3 6 $new_y $new_x $new_y $new_x]
    if {
      [expr [lindex $coords 4] - [lindex $coords 0]] > 15 &&
      [expr [lindex $coords 5] - [lindex $coords 1]] > 15 &&
      [expr $x - [lindex $coords 0]] > 15 &&
      [expr $y - [lindex $coords 1]] > 15 
        } {
      $w coords $tag $coords
      $w move ${tag}_s $dx $dy
      gr_exec gr_scale [lindex $patches($tag) 0] [list $scx 1 $scy] 1
      gr_redraw
    }
    
  } else {
    $w move $tag $dx $dy
    set xm [expr $dx/$factor]
    set ym [expr $dy/$factor]
    
    gr_exec gr_translate [lindex $patches($tag) 0] [list $xm 0 $ym] 1
    gr_redraw
  }
}


ResetAll


