# -----------------------------------------------------------------------
# Initial user interface state
# -----------------------------------------------------------------------


# Initially the mouse buttons assumed to all be up
set b1 0
set b2 0
set b3 0

# -----------------------------------------------------------------------
# Reset state to default
# -----------------------------------------------------------------------
proc ResetAll {} {
    global mode raster 

    # reset user interface state
    set mode orient

    # reset Gr state
    gr_exec gr_reset

    catch {
        ResetPosition
        ResetOrientation
        ResetJoints
    }

    # post redisplay request
    gr_redraw
}

# -----------------------------------------------------------------------
# Reset state and enter main Tk event-processing loop
# -----------------------------------------------------------------------

set comments 0

proc ResetPosition {} {
    gr_exec gr_identity :
    gr_exec gr_translate : {0 -0 -15}
#    gr_exec gr_translate : {-1.5 -7 -6}
#    gr_exec gr_translate : {0 -2 0}
#    gr_exec gr_rotate :trackball y 70

#gr_translate : {0 -7 -6}

}

proc ResetOrientation {} {
    gr_exec gr_identity :trackball
    gr_exec gr_rotate :trackball x 20
}

proc ResetJoints {} {
  if {0} {
    global attributes
        foreach node [array names attributes] {
            gr_exec gr_identity $node:rot            
        }
  }
}



proc surf {node matetial} {
    global attributes
    set attributes($node) $matetial
#puts "\n\n\ngetting $matetial"
}


