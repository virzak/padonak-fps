{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "fps (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/artifacts/windows/Debug/fps.exe",
      "cwd": "${workspaceFolder}/fps",
      "console": "internalConsole",
      "preLaunchTask": "build debug"
    },
    {
      "name": "fps (Linux / WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/artifacts/linux/fps",
      "cwd": "${workspaceFolder}/fps",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build debug"
    }
  ]
}
